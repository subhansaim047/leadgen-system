# ============================================================
# LEADGEN SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to git.
# ============================================================

# --- DATABASE ---
POSTGRES_USER=leadgen_admin
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=leadgen
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://leadgen_admin:change_this_strong_password@db:5432/leadgen

# --- FASTAPI BACKEND ---
API_HOST=0.0.0.0
API_PORT=8000
# Secret token for n8n -> FastAPI service-to-service authentication
API_SECRET_TOKEN=change_this_secret_token_32_chars_min

# --- NEXT.JS FRONTEND ---
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=change_this_nextauth_secret_32_chars
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# --- LEAD DISCOVERY ---
# Outscraper (Google Maps data): https://outscraper.com
OUTSCRAPER_API_KEY=your_outscraper_api_key_here

# Apify (No-Website Finder Actor): https://apify.com
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=blueberry_delicacy/no-website-finder

# SerpApi (Google Search fallback): https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# --- EMAIL DISCOVERY ---
# Apollo.io (B2B email finder): https://apollo.io
APOLLO_API_KEY=your_apollo_api_key_here

# Hunter.io (fallback email finder): https://hunter.io
HUNTER_API_KEY=your_hunter_api_key_here

# ZeroBounce (email verification): https://zerobounce.net
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# --- AI / OPENAI ---
# OpenAI: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# --- EMAIL OUTREACH ---
# Smartlead (cold email campaigns): https://smartlead.ai
SMARTLEAD_API_KEY=your_smartlead_api_key_here
SMARTLEAD_CAMPAIGN_ID=your_campaign_id_here

# Resend (transactional fallback): https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=outreach@yourdomain.com

# --- GOOGLE SHEETS SYNC (Optional) ---
GOOGLE_SHEETS_CREDENTIALS_JSON=path_to_service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here

# --- ALERTS (Optional) ---
# Discord webhook for system failure notifications
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- N8N ---
N8N_HOST=http://n8n:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_n8n_password

# --- PLAYWRIGHT ---
# Max parallel browser instances (keep low on VPS to avoid OOM)
PLAYWRIGHT_MAX_CONCURRENCY=5
PLAYWRIGHT_TIMEOUT_MS=15000

# --- DAILY LEAD QUOTAS ---
DAILY_LEAD_TARGET=500
MAX_LEADS_PER_NICHE_PER_DAY=50
