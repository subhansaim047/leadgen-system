{
  "manifest_version": 3,
  "name": "LeadGen System Real Scraper",
  "version": "1.0",
  "description": "Visual auto-scrolling scraper for Google Maps connected to LeadGen Dashboard.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content-app.js"]
    },
    {
      "matches": [
        "http://*.google.com/maps*",
        "https://*.google.com/maps*",
        "http://maps.google.com/*",
        "https://maps.google.com/*",
        "http://*/*maps*",
        "https://*/*maps*",
        "http://*.google.com/search*",
        "https://*.google.com/search*",
        "http://*.yelp.com/*",
        "https://*.yelp.com/*"
      ],
      "js": ["content-maps.js"]
    }
  ]
}
