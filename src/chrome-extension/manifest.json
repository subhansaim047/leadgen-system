{
  "manifest_version": 3,
  "name": "LeadGen System Real Scraper",
  "version": "1.0",
  "description": "Visual auto-scrolling scraper for Google Maps connected to LeadGen Dashboard.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "*://www.google.com/maps/*",
    "*://localhost/*",
    "*://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://localhost/*", "*://*.vercel.app/*"],
      "js": ["content-app.js"]
    },
    {
      "matches": ["*://www.google.com/maps/*"],
      "js": ["content-maps.js"]
    }
  ]
}
