{
  "manifest_version": 3,
  "name": "LeadGen System Real Scraper",
  "version": "2.0",
  "description": "Multi-platform live lead scraper for Google Maps, LinkedIn, Facebook, Instagram, Yelp, Bing, Chamber of Commerce.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content-app.js"]
    },
    {
      "matches": [
        "https://*.google.com/maps*",
        "http://*.google.com/maps*",
        "https://maps.google.com/*",
        "http://maps.google.com/*",
        "https://*.duckduckgo.com/*",
        "http://*.duckduckgo.com/*",
        "https://html.duckduckgo.com/*",
        "http://html.duckduckgo.com/*",
        "https://*.yelp.com/*",
        "http://*.yelp.com/*",
        "https://*.bing.com/maps*",
        "http://*.bing.com/maps*",
        "https://*.bing.com/search*",
        "http://*.bing.com/search*"
      ],
      "js": ["content-maps.js"]
    }
  ]
}
